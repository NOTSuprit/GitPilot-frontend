# GitPilot frontend — environment variables
#
# Copy this file to `.env.local` and adjust. `.env.local` is git-ignored and
# must never be committed. This is the ONLY variable the frontend reads.

# Optional. Base URL the browser uses for backend requests (`/api/...` and the
# GitHub OAuth start link `/oauth2/authorization/github`).
#
# Leave it EMPTY (recommended) to make same-origin requests: next.config.ts
# rewrites /api, /oauth2 and /login to the backend, which keeps the session
# cookie first-party. Set it only to call a backend directly, e.g.
# http://localhost:8080 — the backend then has to allow your origin with
# credentials (CORS) and set cookies that work cross-site.
#
# NEXT_PUBLIC_* values are bundled into client code. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=
